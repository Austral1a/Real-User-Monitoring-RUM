{
  "name": "monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "MONITOR_DEV=1 tsx watch src/server.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "pnpm build && tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig web/tsconfig.json"
  },
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "express": "^5.3.0",
    "geoip-country": "^5.0.202610100242"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "bits-ui": "^2.19.5",
    "cn": "^0.4.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
