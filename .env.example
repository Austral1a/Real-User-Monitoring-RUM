# Copy to .env and fill in values. Production requires every variable
# except MONITOR_PORT, MONITOR_DB_PATH, and MONITOR_TRUST_PROXY.

NODE_ENV=production
MONITOR_PORT=4000

# Comma-separated origins allowed to POST /collect
MONITOR_SITE_ORIGINS=https://example.com

MONITOR_DASHBOARD_USER=admin
MONITOR_DASHBOARD_PASSWORD=

# At least 16 characters. Changing this splits existing visitors from new ones.
MONITOR_HASH_SALT=

# SQLite file. Keep this path across deploys.
MONITOR_DB_PATH=data/rum.sqlite

# Set when a reverse proxy terminates TLS (true, hop count, or subnet).
# MONITOR_TRUST_PROXY=true

# Optional. POST JSON here when p75 LCP or JS error rate is high (humans, last 24h).
# MONITOR_ALERT_WEBHOOK=https://example.com/hooks/rum
